erDiagram
    ROLE ||--o{ USER : "tiene"
    USER ||--o{ CARGA_ARCHIVO : "sube"
    USER ||--o{ AUDITORIA : "genera"
    DEPARTAMENTO ||--o{ MUNICIPIO : "contiene"
    DEPARTAMENTO ||--o{ DEPARTAMENTAL : "tiene"
    DEPARTAMENTAL ||--o{ CASO_EMBARAZO : "supervisa"
    MUNICIPIO ||--o{ CENTRO_EDUCATIVO : "ubica"
    MUNICIPIO ||--o{ NINA : "reside_en"
    NINA ||--o{ CASO_EMBARAZO : "registra"
    NINA ||--o{ HISTORIAL_EDUCATIVO : "tiene"
